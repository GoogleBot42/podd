# U-Boot env access for fw_printenv/fw_setenv (libubootenv).
# Single env copy in the raw SD region. MUST stay in sync with uboot-env.txt /
# post-image.sh (mkenvimage -s 0x1000 @ 0x400000) and the U-Boot config
# (CONFIG_ENV_OFFSET / CONFIG_ENV_SIZE).
# device		offset		size
/dev/mmcblk1	0x400000	0x1000
