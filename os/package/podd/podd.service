[Unit]
Description=podd - open Eight Sleep Pod control daemon
Documentation=https://github.com/GoogleBot42/podd
After=network-online.target
Wants=network-online.target
# Wait for /data to mount before any Exec line runs. This is a [Unit] directive;
# it was previously (wrongly) under [Service], where systemd ignores it with
# "Unknown key 'RequiresMountsFor' in section [Service]" — so podd could race
# the /data mount.
RequiresMountsFor=/data

[Service]
Type=simple
# Clean-room L2 image: podd is installed read-only in the active rootfs slot;
# all mutable state (config, schedules, logs) lives on the persistent data
# partition so it survives an A/B slot swap. OS updates are handled by RAUC, not
# by podd's own updater — hence PODD_UPDATER_ENABLED=false here.
# Seed the persistent config from the baked default on first boot (the data
# partition starts empty); after that the user's copy is authoritative.
# No WorkingDirectory=/data/podd: systemd chdirs there before EVERY Exec line
# (incl. ExecStartPre), so it must already exist -> chicken/egg (status=200/CHDIR
# on first boot). Run from /data (the mountpoint always exists) instead.
ExecStartPre=/bin/sh -c 'mkdir -p /data/podd; test -f /data/podd/config.ron || cp /etc/podd/config.ron /data/podd/config.ron'
ExecStart=/usr/bin/podd /data/podd/config.ron
WorkingDirectory=/data
Restart=always
RestartSec=3

Environment=PODD_API_ADDR=0.0.0.0:3000
Environment=PODD_SPA_DIR=/usr/share/podd/ui
# SAFETY: actuation (TEC/pump control, vibration alarms) is LOGGED, not sent,
# until deliberately armed via a drop-in setting PODD_DRY_RUN=false. Sensing
# config (piezo enable/gain) still goes to the MCU so presence data works.
Environment=PODD_DRY_RUN=true
Environment=RUST_LOG=info
Environment=PODD_UPDATER_ENABLED=false

[Install]
WantedBy=multi-user.target
