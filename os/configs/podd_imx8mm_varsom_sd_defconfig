# Buildroot defconfig — podd clean-room image, Eight Sleep i.MX8M-Mini Variscite
# "SD" hub. STARTING POINT: the structure and key selections are here; version
# pins and a few board-exact values (kernel source, DTB, imx-mkimage target) are
# marked TODO and must be nailed down during phase-1 bring-up. See
# docs/CLEANROOM-OS.md.
#
# Build with:
#   make BR2_EXTERNAL=../os -C <buildroot> podd_imx8mm_varsom_sd_defconfig
#   make -C <buildroot> PODD_BIN=$PWD/result-podd/bin/podd PODD_UI_DIR=$PWD/result-ui

# --- architecture ------------------------------------------------------------
BR2_aarch64=y
BR2_cortex_a53=y

# --- toolchain / init --------------------------------------------------------
# glibc + systemd (NetworkManager, RAUC, and the existing units expect systemd).
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_INIT_SYSTEMD=y
BR2_TARGET_GENERIC_HOSTNAME="podd"
BR2_TARGET_GENERIC_ISSUE="podd (open Eight Sleep firmware)"

# --- board hooks -------------------------------------------------------------
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_PODD_PATH)/board/eightsleep/imx8mm-varsom/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_PODD_PATH)/board/eightsleep/imx8mm-varsom/post-image.sh"

# --- bootloader: ATF + U-Boot -> imx-boot ------------------------------------
# Board pinned from the LIVE device's DTB: compatible = "variscite,dart-mx8mm"
# (a Variscite DART-MX8M-MINI SoM; the "VAR-SOM" model string notwithstanding).
# So base U-Boot on Variscite's DART tree, NOT the VAR-SOM Symphony eval board.
BR2_TARGET_ARM_TRUSTED_FIRMWARE=y
BR2_TARGET_ARM_TRUSTED_FIRMWARE_PLATFORM="imx8mm"
BR2_TARGET_ARM_TRUSTED_FIRMWARE_BL31=y
BR2_TARGET_UBOOT=y
BR2_TARGET_UBOOT_NEEDS_ATF_BL31=y
BR2_TARGET_UBOOT_NEEDS_IMX_MKIMAGE=y
# Candidate (verify exact name/rev at build time): Variscite u-boot-imx fork,
# board defconfig imx8mm_var_dart_defconfig. Rebuilding a SUPPORTED board — the
# running stock system proves this SoM boots this source.
# BR2_TARGET_UBOOT_BOARD_DEFCONFIG="imx8mm_var_dart"   # candidate
# BR2_TARGET_UBOOT_CUSTOM_GIT + rev pinned to the Variscite 5.4.x BSP tag  # verify

# NXP redistributable firmware (DDR PHY training + HDMI). Required by every
# i.MX8M boot chain; NOT Eight Sleep code.
BR2_PACKAGE_FIRMWARE_IMX=y

# --- kernel ------------------------------------------------------------------
# Live device runs Variscite BSP Linux 5.4.127 (aarch64-fslc gcc 10.3, Feb 2022).
# Base our kernel on the Variscite linux-imx 5.4.x DART tree; seed the config from
# the stock .config pulled off the device (../backup/stock-ref/stock-kernel.config)
# and trim to what we need. Our clean-room DTS is authored from the stock DTB
# reference (../backup/stock-ref/stock.dts): DART base + New-Rat carrier deltas —
# enable UART1 (sensor MCU, ttymxc0) + UART3 (frozen MCU, ttymxc2); I2C PMIC@0x4b,
# RTC rv3028@0x68, LED + GPIO expander; Ethernet stays off (no PHY populated).
BR2_LINUX_KERNEL=y
# BR2_LINUX_KERNEL_CUSTOM_GIT=y + Variscite 5.4.x BSP rev  # verify at build time
# BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="...podd_kernel.config"  # from stock seed
BR2_LINUX_KERNEL_DTS_SUPPORT=y
# BR2_LINUX_KERNEL_CUSTOM_DTS_PATH=".../imx8mm-podd.dts" -> /boot/podd.dtb
BR2_LINUX_KERNEL_IMAGEGZ=y

# --- update engine -----------------------------------------------------------
BR2_PACKAGE_RAUC=y
BR2_PACKAGE_RAUC_NETWORK=y

# --- userland ----------------------------------------------------------------
BR2_PACKAGE_PODD=y
BR2_PACKAGE_NETWORK_MANAGER=y
BR2_PACKAGE_OPENSSH=y
BR2_PACKAGE_IPTABLES=y
BR2_PACKAGE_E2FSPROGS=y
# WiFi firmware for the on-board Broadcom (brcmfmac BCM4339 SDIO).
BR2_PACKAGE_LINUX_FIRMWARE=y
BR2_PACKAGE_LINUX_FIRMWARE_BRCM_BCM43XXX=y

# --- image tooling -----------------------------------------------------------
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_LABEL="rootfs_a"
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_UBOOT_TOOLS=y
BR2_PACKAGE_HOST_UBOOT_TOOLS_MKENVIMAGE=y
