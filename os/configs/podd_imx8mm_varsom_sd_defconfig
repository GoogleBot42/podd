# Buildroot defconfig — podd clean-room image, Eight Sleep i.MX8M-Mini Variscite
# "SD" hub. The SoM is a VAR-SOM-MX8M-MINI (DDR4): confirmed from the live
# device's U-Boot env (board_name=VAR-SOM-MX8M-MINI, som_rev13, sdram_size=4096)
# and its kernel DTB (imx8mm-var-som-symphony-eight.dtb). Variscite's U-Boot
# unifies DART-MX8M-MINI (LPDDR4) + VAR-SOM (DDR4) in one imx8mm_var_dart build
# that runtime-selects DDR timing and control DTB from the SOM EEPROM.
#
# The upstream source revisions are PINNED here (U-Boot, kernel, ATF, firmware,
# Buildroot itself — see os/scripts/build-image.sh for the Buildroot pin). They
# correspond to the Variscite Yocto Hardknott v1.4 BSP that the live stock device
# was built from (Linux 5.4.127; the stock bootloader banner is
# "U-Boot 2020.04-imx_v2020.04_5.4.70_2.3.0_var01"), so we are rebuilding a
# *supported* board, not porting a new one. See docs/CLEANROOM-OS.md.
#
# Boot-chain assembly (from source; verified against the stock Pod 3 SD dump):
#   * U-Boot (Variscite fork) builds u-boot-nodtb.bin + u-boot-spl.bin + BOTH
#     control DTBs (imx8mm-var-dart-customboard + imx8mm-var-som-symphony).
#   * ATF (Variscite fork) builds bl31.bin (imx8mm platform, BL31 @ 0x920000).
#   * firmware-imx provides the NXP DDR PHY training blobs (LPDDR4 *and* DDR4 —
#     the unified SPL needs both, ddr4 set at fixed offset 73728 after the
#     lpddr4 set); host imx-mkimage installs mkimage_imx8 / mkimage_fit_atf.sh.
#   * Our board post-image.sh assembles the whole boot container itself (the
#     generic Buildroot imx8 prepare script packs lpddr4-only fw + one DTB,
#     which is dead-on-arrival on this DDR4 VAR-SOM), places it at 0x8400,
#     bakes the RAUC U-Boot env, and runs genimage to emit podd-sd.img(.gz).
#
# Build with (see os/scripts/build-image.sh which wraps this):
#   make BR2_EXTERNAL=/abs/path/os -C <buildroot> podd_imx8mm_varsom_sd_defconfig
#   make -C <buildroot> PODD_BIN=.../result-podd/bin/podd PODD_UI_DIR=.../result-ui

# --- architecture ------------------------------------------------------------
BR2_aarch64=y
BR2_cortex_a53=y

# --- toolchain / init --------------------------------------------------------
# Kernel headers come from our custom kernel (AS_KERNEL, the default), but for a
# custom-git kernel Buildroot can't infer the version, so it leaves
# HEADERS_AT_LEAST at the 2.6 floor — which (a) fails the strict headers check
# ("expected 2.6.x, got 5.4.x") and (b) hides glibc (needs headers >= 3.2),
# silently falling back to uClibc (which would then break systemd). Declare the
# headers series explicitly so HEADERS_AT_LEAST_5_4 is selected.
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_5_4=y
# glibc + systemd (NetworkManager, RAUC, and the existing units expect systemd).
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_INIT_SYSTEMD=y
BR2_TARGET_GENERIC_HOSTNAME="podd"
BR2_TARGET_GENERIC_ISSUE="podd (open Eight Sleep firmware)"
# busybox httpd (+CGI) for the WiFi provisioning portal (podd-wifi-setup).
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_PODD_PATH)/board/eightsleep/imx8mm-varsom/busybox.fragment"

# --- board hooks -------------------------------------------------------------
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_PODD_PATH)/board/eightsleep/imx8mm-varsom/post-build.sh"
# ONE post-image script: our board post-image.sh assembles the ENTIRE boot
# container itself (SPL + dual LPDDR4/DDR4 DDR fw + ATF + dual-DTB U-Boot FIT),
# then env + genimage -> podd-sd.img. We deliberately do NOT use Buildroot's
# generic board/freescale/common/imx/imx8-bootloader-prepare.sh: it appends only
# ONE DDR fw set (lpddr4) and packs only ONE control DTB — both fatally wrong
# for Variscite's unified DART/VAR-SOM U-Boot on our VAR-SOM (DDR4) hardware.
# See the analysis comments in post-image.sh.
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_PODD_PATH)/board/eightsleep/imx8mm-varsom/post-image.sh"

# --- bootloader: ARM Trusted Firmware (BL31) ---------------------------------
# Variscite's imx-atf fork, branch imx_5.4.70_2.3.0_var01 — the exact ATF that
# shipped in the Hardknott v1.4 BSP for this SoM. Pinned to the branch HEAD.
# BL31 base for imx8mm is 0x00920000 (matches the prepare script's ATF_LOAD_ADDR).
# VERIFY: this is a ~2020 TF-A (v2.2-based); if it fails to compile with the
# Buildroot 2026.02 host GCC, the drop-in fallback is mainline TF-A (built-in,
# BR2_TARGET_ARM_TRUSTED_FIRMWARE_LATEST_VERSION=y) which also supports imx8mm.
BR2_TARGET_ARM_TRUSTED_FIRMWARE=y
BR2_TARGET_ARM_TRUSTED_FIRMWARE_CUSTOM_GIT=y
BR2_TARGET_ARM_TRUSTED_FIRMWARE_CUSTOM_REPO_URL="https://github.com/varigit/imx-atf.git"
BR2_TARGET_ARM_TRUSTED_FIRMWARE_CUSTOM_REPO_VERSION="e5884084510a2a88101351bed3710860c28c0657"
BR2_TARGET_ARM_TRUSTED_FIRMWARE_PLATFORM="imx8mm"
BR2_TARGET_ARM_TRUSTED_FIRMWARE_BL31=y
# This ~2020 ATF vs the modern cross-toolchain needs two warning workarounds
# (both harmless — no secure boot here, and firmware legitimately has an RWX
# segment):
#   E=0                       compiler: HAB (secure-boot) code reads a fixed ROM
#                             address -> -Werror=array-bounds. Don't treat
#                             warnings as errors.
#   TF_LDFLAGS_aarch64=...    linker: ATF hardcodes --fatal-warnings, and ld 2.44
#                             warns on ATF's RWX LOAD segment. The per-arch var is
#                             appended after --fatal-warnings, so --no-warn-rwx-
#                             segments suppresses that warning before it turns fatal.
BR2_TARGET_ARM_TRUSTED_FIRMWARE_ADDITIONAL_VARIABLES="E=0 TF_LDFLAGS_aarch64=--no-warn-rwx-segments"
# License-file path for the custom-git ATF (Buildroot needs it for legal-info).
BR2_TARGET_ARM_TRUSTED_FIRMWARE_LICENSE_FILES="docs/license.rst"  # VERIFY path in fork

# --- bootloader: U-Boot ------------------------------------------------------
# Variscite u-boot-imx fork, branch imx_v2020.04_5.4.70_2.3.0_var01 (U-Boot
# v2020.04), pinned to branch HEAD. Board defconfig imx8mm_var_dart_defconfig —
# Buildroot appends "_defconfig". Rebuilding a SUPPORTED board: the live stock
# system was built from this same source, which proves this SoM boots this code.
# We emit u-boot-nodtb.bin + the SPL; the FIT/container is assembled by the
# prepare post-image script (NOT by U-Boot), so no NEEDS_ATF_BL31 here.
BR2_TARGET_UBOOT=y
BR2_TARGET_UBOOT_BUILD_SYSTEM_KCONFIG=y
BR2_TARGET_UBOOT_CUSTOM_GIT=y
BR2_TARGET_UBOOT_CUSTOM_REPO_URL="https://github.com/varigit/uboot-imx.git"
BR2_TARGET_UBOOT_CUSTOM_REPO_VERSION="bbb07703e6386cb98d7275df57f5e2c08aeeb4f0"
BR2_TARGET_UBOOT_BOARD_DEFCONFIG="imx8mm_var_dart"
BR2_TARGET_UBOOT_NEEDS_DTC=y
BR2_TARGET_UBOOT_NEEDS_OPENSSL=y
BR2_TARGET_UBOOT_FORMAT_CUSTOM=y
BR2_TARGET_UBOOT_FORMAT_CUSTOM_NAME="u-boot-nodtb.bin"
BR2_TARGET_UBOOT_SPL=y

# --- NXP i.MX firmware + boot-image tooling ----------------------------------
# FREESCALE_IMX (platform imx8mm) pulls the LPDDR4 training blobs via firmware-imx
# and selects the right ddr_fw.bin assembly. firmware-imx = NXP redistributable
# DDR PHY training (+ HDMI); required by EVERY i.MX8M boot chain, NOT Eight code.
# host imx-mkimage provides mkimage_imx8 / mkimage_fit_atf.sh used by the prepare
# script. (This mirrors Buildroot's freescale_imx8mmevk_defconfig exactly.)
BR2_PACKAGE_FREESCALE_IMX=y
BR2_PACKAGE_FREESCALE_IMX_PLATFORM_IMX8MM=y
BR2_PACKAGE_FIRMWARE_IMX=y
BR2_PACKAGE_HOST_IMX_MKIMAGE=y

# --- kernel ------------------------------------------------------------------
# Variscite linux-imx fork, branch 5.4-2.3.x-imx_var01 (Linux 5.4.127, the exact
# BSP the live device runs), pinned to branch HEAD. Config + DTS are authored by
# sibling work in board/eightsleep/imx8mm-varsom/:
#   * linux-podd.config  — kernel .config fragment/seed (from the stock .config)
#   * imx8mm-podd.dts     — clean-room DTS (DART base + New-Rat carrier deltas:
#     UART1 sensor MCU/ttymxc0 + UART3 frozen MCU/ttymxc2; I2C PMIC/RTC/LED/GPIO
#     expander; Ethernet off — no PHY populated).
# VERIFY: building a 5.4 kernel with the Buildroot 2026.02 host toolchain may need
# host-CC tweaks; if so, pin an older Buildroot (2024.02 LTS) whose host gcc is
# closer to the BSP's aarch64-fslc gcc 10.3.
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_GIT=y
BR2_LINUX_KERNEL_CUSTOM_REPO_URL="https://github.com/varigit/linux-imx.git"
BR2_LINUX_KERNEL_CUSTOM_REPO_VERSION="a397cce0a33608443cb61f86aa1b9d7e60e8a4ef"
# Select the "use a custom .config" choice (required — without it Buildroot
# defaults to USE_DEFCONFIG and errors "No kernel defconfig name specified").
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_PODD_PATH)/board/eightsleep/imx8mm-varsom/linux-podd.config"
BR2_LINUX_KERNEL_IMAGEGZ=y
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_CUSTOM_DTS_PATH="$(BR2_EXTERNAL_PODD_PATH)/board/eightsleep/imx8mm-varsom/imx8mm-podd.dts"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
# The kernel + DTB are staged into each slot's /boot by board post-build.sh,
# renaming imx8mm-podd.dtb -> /boot/podd.dtb to match uboot-env.txt (resolved).

# --- update engine -----------------------------------------------------------
BR2_PACKAGE_RAUC=y
BR2_PACKAGE_RAUC_NETWORK=y

# --- userland ----------------------------------------------------------------
BR2_PACKAGE_PODD=y
BR2_PACKAGE_NETWORK_MANAGER=y
# nmcli is a separate option and podd-wifi-setup is built entirely on it —
# without this the provisioning AP silently never comes up (the daemon alone
# still auto-joins baked keyfile profiles, which masked the gap).
BR2_PACKAGE_NETWORK_MANAGER_CLI=y
# NetworkManager does NOT pull in a WiFi backend; without wpa_supplicant it can't
# associate to WPA networks. nl80211 driver + dbus control (so NM drives it).
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_WPA_SUPPLICANT_DBUS=y
# NM runs AP mode *through the supplicant* (CONFIG_AP), and the BCM4339 driver
# alone advertising AP support isn't enough — without this NM rejects the
# provisioning AP profile: "wpa_supplicant does not support Access Point mode".
BR2_PACKAGE_WPA_SUPPLICANT_AP_SUPPORT=y
# NM shells out to dnsmasq at runtime for shared-mode (AP) connections; needed
# by the podd-wifi-setup provisioning AP. DHCP support is on by default.
BR2_PACKAGE_DNSMASQ=y
# BR2_PACKAGE_DNSMASQ_TFTP is not set
BR2_PACKAGE_OPENSSH=y
BR2_PACKAGE_IPTABLES=y
BR2_PACKAGE_E2FSPROGS=y
# tzdata: podd (jiff) parses a timezone from its config and needs the zoneinfo
# database, else it fails "failed to find time zone ... in time zone database".
# NOTE: BR2_PACKAGE_TZDATA is a *blind* (promptless) symbol — setting it in a
# defconfig is silently DROPPED by Kconfig (exactly what shipped in the broken
# image: no /usr/share/zoneinfo despite the line being present). The
# user-visible knob is BR2_TARGET_TZ_INFO, which selects tzdata and installs
# the compiled zoneinfo db (zonelist "default" includes America/New_York).
BR2_TARGET_TZ_INFO=y
BR2_TARGET_LOCALTIME="Etc/UTC"
# WiFi firmware for the on-board Broadcom (brcmfmac BCM4339 SDIO).
BR2_PACKAGE_LINUX_FIRMWARE=y
BR2_PACKAGE_LINUX_FIRMWARE_BRCM_BCM43XXX=y
# Regulatory database for cfg80211 (/lib/firmware/regulatory.db + .p7s); the
# booted image logged "cfg80211: failed to load regulatory.db" (file absent).
# Loads correctly now that cfg80211 is a module (probes after rootfs mount).
BR2_PACKAGE_WIRELESS_REGDB=y

# --- rootfs overlay (non-secret reachability config: NM.conf, muzzle, sshd) ---
# Owner-specific secrets (WiFi PSK, SSH authorized_keys) are NOT here — they are
# injected by post-build.sh from a gitignored dir if present (see post-build.sh).
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_PODD_PATH)/board/eightsleep/imx8mm-varsom/rootfs-overlay"

# --- image tooling -----------------------------------------------------------
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_LABEL="rootfs_a"
# Sized to the A/B slot in genimage.cfg (512 MiB). Keep in sync with that file.
BR2_TARGET_ROOTFS_EXT2_SIZE="512M"
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_UBOOT_TOOLS=y
BR2_PACKAGE_HOST_UBOOT_TOOLS_MKENVIMAGE=y
