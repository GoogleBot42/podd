// Example podd config for an Eight Sleep **Pod 3**.
//
// The `device` section pins the Pod 3 sensor MCU firmware baud (115200). This
// matches the historical hard-coded defaults, so `device` could be omitted
// entirely on Pod 3; it is shown here for clarity and parity with the Pod 4
// example.
(
    timezone: "America/New_York",

    // Away mode will disable temperature control and alarms
    away_mode: false,

    // What time to prime the bed. Make sure this does not interfere with the sleep profile.
    prime: "15:00",

    led: (
        // SlowBreath(r, g, b)
        // FastBreath(r, g, b)
        // Off
        // Fixed(r, g, b)
        // FastRainbowBreath
        // SlowRainbowBreath
        //  .. see more in `src/led/patterns.rs`
        idle: Fixed(0, 255, 0),
        active: SlowBreath(255, 0, 0),

        // One: 0mA\~10mA, Imax=10mA
        // Two: 0mA\~20mA, Imax=20mA
        // Three: 0mA\~30mA, Imax=30mA
        // Four: 0mA\~40mA, Imax=40mA
        band: Three,
    ),

    mqtt: (
        server: "homeassistant.local",
        port: 1883,
        user: "example",
        password: "1234"
    ),

    profile: Solo(
        (
            // Define as many points you want. They are evenly spread apart
            // Temperatures will be linearly interpolated between
            // This is in degrees celcius. You may provide floating-point numbers.
            // A "nuetral" temp is 29, but I prefer much colder at like 20
            temperatures: [27, 29, 31],

            // Time to start temperature profile
            sleep: "22:00",

            // Time to end temperature profile
            wake: "10:30",

            // Vibration alarm — OFF unless you opt in. (This example used to
            // ship with an active alarm; installs seeded from it woke people
            // who never asked for one.) To enable, uncomment:
            // alarm: (
            //     // Double or Single
            //     pattern: Double,
            //     // Intensity 0-100
            //     intensity: 80,
            //     // Duration in seconds
            //     duration: 600,
            //     // Offset from wake time in seconds.
            //     // In this case it will trigger at 10:25
            //     offset: 300,
            // ),
        )
    ),

    // ---- Presence detection (optional, capacitance-based) ----
    //
    // Leave this section out and presence detection stays off (podd logs a
    // "please calibrate" warning at startup; everything else still works).
    //
    // The numbers are *calibrated*, not hand-authored: with the bed empty,
    // publish an empty message to the MQTT topic `opensleep/actions/calibrate`.
    // podd averages ~10 s of capacitance samples and logs the result as
    // `Config updated: [...]`; copy those six numbers into `baselines` below
    // (calibration is not persisted automatically yet — issue #27).
    //
    // presence: (
    //     // Empty-bed capacitance per channel: 0-2 = left side, 3-5 = right.
    //     baselines: [0, 0, 0, 0, 0, 0],
    //     // How far above its baseline a channel must read to count as
    //     // occupied. Default 50; raise it if presence flaps.
    //     threshold: 50,
    //     // Consecutive over-threshold samples (~2 Hz) before a side flips
    //     // to occupied. Default 5.
    //     debounce_count: 5,
    // ),

    // ---- Hardware wiring (Pod 3) ----
    //
    // Every field here is optional and falls back to a default. `cover: pod3`
    // selects the Pod 3 sensor firmware baud (115200, opensleep's value).
    device: (
        // pod3 | pod4 -- selects sensor_firmware_baud default (115200 | 921600)
        cover: pod3,

        // Frozen (TEC/pump) MCU.
        frozen_port: "/dev/ttymxc2",
        frozen_baud: 38400,

        // Sensor (presence/temp/piezo) MCU.
        sensor_port: "/dev/ttymxc0",
        sensor_bootloader_baud: 38400,
        // Pod 3 firmware baud. (cover: pod3 already implies this.)
        sensor_firmware_baud: 115200,

        // I2C bus + addresses.
        i2c_bus: "/dev/i2c-1",
        pcal6416a_addr: 0x20, // MCU reset expander
        led_addr: 0x53,       // IS31FL3194 LED controller
    ),
)
